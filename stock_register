#include <stdio.h>
#include <stdlib.h>

/* Structure to store item details in stock register */
struct Item {
    int id;             /* Item / Product code (e.g. 101, 102) */
    char name[50];      /* Item name (e.g. Keyboard, Notebook) */
    int quantity;       /* Current available stock quantity */
    float price;        /* Unit price */
};

/* Function prototypes */
void addItem(void);
void displayAll(void);
void searchItem(void);
void updateQuantity(void);
void displayLowStock(void);

/* 1. Add new item to stock file */
void addItem(void) {
    struct Item item;
    FILE *fp;

    /* Open file in append mode to add item at the end */
    fp = fopen("stock.txt", "a");
    if (fp == NULL) {
        printf("\nError: Cannot open or create stock file!\n");
        return;
    }

    printf("\n--- Add New Stock Item ---\n");
    printf("Enter Item Code (number): ");
    scanf("%d", &item.id);

    printf("Enter Item Name (single word or use _ for space): ");
    scanf("%s", item.name);

    printf("Enter Quantity: ");
    scanf("%d", &item.quantity);

    printf("Enter Unit Price: ");
    scanf("%f", &item.price);

    /* Write record to text file */
    fprintf(fp, "%d %s %d %.2f\n", item.id, item.name, item.quantity, item.price);
    fclose(fp);

    printf("\nItem '%s' added successfully to stock!\n", item.name);
}

/* 2. Display all stock items and calculate total inventory value */
void displayAll(void) {
    struct Item item;
    FILE *fp;
    int count = 0;
    int total_units = 0;
    float total_value = 0.0f;

    /* Open file in read mode */
    fp = fopen("stock.txt", "r");
    if (fp == NULL) {
        printf("\nStock is empty! (stock.txt does not exist yet).\n");
        return;
    }

    printf("\n--------------------------------------------------------------\n");
    printf("%-10s %-20s %-10s %-10s %-10s\n", "ItemCode", "ItemName", "Quantity", "Price", "TotalVal");
    printf("--------------------------------------------------------------\n");

    /* Read record by record until End Of File (EOF) */
    while (fscanf(fp, "%d %s %d %f", &item.id, item.name, &item.quantity, &item.price) == 4) {
        float item_val = item.quantity * item.price;
        printf("%-10d %-20s %-10d %-10.2f %-10.2f\n", item.id, item.name, item.quantity, item.price, item_val);
        count++;
        total_units += item.quantity;
        total_value += item_val;
    }

    printf("--------------------------------------------------------------\n");
    printf("Total Items: %d | Total Stock Units: %d | Total Valuation: Rs. %.2f\n", 
           count, total_units, total_value);

    fclose(fp);
}

/* 3. Search an item by its Item Code */
void searchItem(void) {
    struct Item item;
    FILE *fp;
    int search_id;
    int found = 0;

    fp = fopen("stock.txt", "r");
    if (fp == NULL) {
        printf("\nStock is empty! No items to search.\n");
        return;
    }

    printf("\nEnter Item Code to search: ");
    scanf("%d", &search_id);

    while (fscanf(fp, "%d %s %d %f", &item.id, item.name, &item.quantity, &item.price) == 4) {
        if (item.id == search_id) {
            printf("\n==================================\n");
            printf("            ITEM FOUND            \n");
            printf("==================================\n");
            printf("Item Code : %d\n", item.id);
            printf("Item Name : %s\n", item.name);
            printf("Quantity  : %d units\n", item.quantity);
            printf("Price     : Rs. %.2f\n", item.price);
            printf("Stock Val : Rs. %.2f\n", item.quantity * item.price);
            printf("==================================\n");
            found = 1;
            break;
        }
    }

    if (found == 0) {
        printf("\nItem with Code %d was not found in the register.\n", search_id);
    }

    fclose(fp);
}

/* 4. Update quantity of an existing item (Restock or Sell) */
void updateQuantity(void) {
    struct Item item;
    FILE *fp, *temp;
    int target_id;
    int found = 0;
    int choice;

    fp = fopen("stock.txt", "r");
    if (fp == NULL) {
        printf("\nStock is empty! Nothing to update.\n");
        return;
    }

    temp = fopen("temp.txt", "w");
    if (temp == NULL) {
        printf("\nError opening temporary file!\n");
        fclose(fp);
        return;
    }

    printf("\nEnter Item Code to update: ");
    scanf("%d", &target_id);

    while (fscanf(fp, "%d %s %d %f", &item.id, item.name, &item.quantity, &item.price) == 4) {
        if (item.id == target_id) {
            found = 1;
            printf("\nFound Item: %s (Current Stock: %d units)\n", item.name, item.quantity);
            printf("1. Restock (Add units)\n");
            printf("2. Sell / Dispatch (Deduct units)\n");
            printf("3. Set New Exact Quantity\n");
            printf("Enter choice (1-3): ");
            scanf("%d", &choice);

            if (choice == 1) {
                int add;
                printf("Enter quantity to add: ");
                scanf("%d", &add);
                item.quantity += add;
                printf("Stock updated! New quantity: %d\n", item.quantity);
            } else if (choice == 2) {
                int sell;
                printf("Enter quantity to deduct: ");
                scanf("%d", &sell);
                if (sell <= item.quantity) {
                    item.quantity -= sell;
                    printf("Transaction successful! Remaining stock: %d\n", item.quantity);
                } else {
                    printf("Error: Insufficient stock! Available stock is only %d units\n", item.quantity);
                }
            } else if (choice == 3) {
                printf("Enter new total quantity: ");
                scanf("%d", &item.quantity);
                printf("Stock quantity updated to %d\n", item.quantity);
            } else {
                printf("Invalid choice. Quantity remains unchanged.\n");
            }
        }
        /* Write to temporary file */
        fprintf(temp, "%d %s %d %.2f\n", item.id, item.name, item.quantity, item.price);
    }

    fclose(fp);
    fclose(temp);

    /* Atomic swap: Replace original file with temporary file */
    remove("stock.txt");
    rename("temp.txt", "stock.txt");

    if (found == 0) {
        printf("\nItem with Code %d was not found.\n", target_id);
    }
}

/* 5. Display items below a specified stock level (Low-Stock Alert) */
void displayLowStock(void) {
    struct Item item;
    FILE *fp;
    int threshold;
    int alert_count = 0;

    fp = fopen("stock.txt", "r");
    if (fp == NULL) {
        printf("\nStock is empty! No items to evaluate.\n");
        return;
    }

    printf("\nEnter low-stock threshold limit (e.g. 10): ");
    scanf("%d", &threshold);

    printf("\n--------------------------------------------------------------\n");
    printf("         ITEMS BELOW %d UNITS (LOW-STOCK ALERT)               \n", threshold);
    printf("--------------------------------------------------------------\n");
    printf("%-10s %-20s %-10s %-10s %-12s\n", "ItemCode", "ItemName", "Quantity", "Price", "Status");
    printf("--------------------------------------------------------------\n");

    while (fscanf(fp, "%d %s %d %f", &item.id, item.name, &item.quantity, &item.price) == 4) {
        if (item.quantity < threshold) {
            char *status = (item.quantity == 0) ? "OUT OF STOCK" : "REORDER NOW";
            printf("%-10d %-20s %-10d %-10.2f %-12s\n", item.id, item.name, item.quantity, item.price, status);
            alert_count++;
        }
    }

    printf("--------------------------------------------------------------\n");
    if (alert_count == 0) {
        printf("Good news: All inventory items have %d or more units in stock.\n", threshold);
    } else {
        printf("Alert: %d item(s) are running low and need reordering!\n", alert_count);
    }

    fclose(fp);
}

/* Main driver function with interactive menu */
int main(void) {
    int choice;

    do {
        printf("\n============================================\n");
        printf("           STOCK  MANAGEMENT SYSTEM      \n");
        printf("============================================\n");
        printf("1. Add New Stock Item\n");
        printf("2. Display All Items (with Total Valuation)\n");
        printf("3. Search Item by Item Code\n");
        printf("4. Update Stock Quantity (Restock/Sell)\n");
        printf("5. View Low-Stock Alert Report (< Threshold)\n");
        printf("6. Exit\n");
        printf("============================================\n");
        printf("Enter your choice (1-6): ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                addItem();
                break;
            case 2:
                displayAll();
                break;
            case 3:
                searchItem();
                break;
            case 4:
                updateQuantity();
                break;
            case 5:
                displayLowStock();
                break;
            case 6:
                printf("\nExiting Stock Register System. All data is saved safely.\n");
                break;
            default:
                printf("\nInvalid choice! Please enter a number between 1 and 6.\n");
                break;
        }
    } while (choice != 6);

    return 0;
}
